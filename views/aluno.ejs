<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal do Aluno - Colégio Lilian</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background: #f4f7f6; color: #333; }
        header { background: #1e3c72; color: white; padding: 20px 40px; display: flex; justify-content: space-between; align-items: center; }
        header h1 { font-size: 22px; }
        header a { color: white; text-decoration: none; background: #d9534f; padding: 8px 16px; border-radius: 4px; font-size: 14px; }
        .container { max-width: 1000px; margin: 30px auto; padding: 0 20px; }
        .card { background: white; padding: 25px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.05); margin-bottom: 25px; }
        .card h2 { color: #1e3c72; margin-bottom: 15px; font-size: 18px; border-bottom: 2px solid #f0f0f0; padding-bottom: 8px; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { padding: 12px; text-align: left; border-bottom: 1px solid #ddd; font-size: 14px; }
        th { background: #f8f9fa; color: #1e3c72; }
        .aviso-item { background: #eef2f7; padding: 15px; border-left: 4px solid #1e3c72; border-radius: 4px; margin-bottom: 10px; }
        .aviso-item h3 { font-size: 16px; color: #1e3c72; margin-bottom: 5px; }
        .aviso-item p { font-size: 14px; color: #555; }
        .info-aluno p { margin-bottom: 8px; font-size: 15px; }
    </style>
</head>
<body>
    <header>
        <h1>Colégio Lilian - Portal do Aluno</h1>
        <a href="/">Sair</a>
    </header>

    <div class="container">
        <div class="card info-aluno">
            <h2>Dados do Aluno</h2>
            <p><b>Nome:</b> <%= aluno.nome %></p>
            <p><b>Matrícula:</b> <%= aluno.matricula %></p>
            <p><b>Turma:</b> <%= aluno.turma %></p>
            <p><b>Responsável:</b> <%= aluno.responsavel %> (<%= aluno.telefone %>)</p>
        </div>

        <div class="card">
            <h2>Boletim e Frequência (1º Bimestre)</h2>
            <table>
                <thead>
                    <tr>
                        <th>Matéria</th>
                        <th>Bimestre</th>
                        <th>Nota</th>
                        <th>Faltas</th>
                    </tr>
                </thead>
                <tbody>
                    <% notas.forEach(n => { %>
                        <tr>
                            <td><%= n.materia %></td>
                            <td><%= n.bimestre %>º Bimestre</td>
                            <td><b><%= n.nota %></b></td>
                            <td><%= n.faltas %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <div class="card">
            <h2>Mural de Avisos e Comunicados</h2>
            <% if (avisos.length === 0) { %>
                <p>Nenhum aviso no momento.</p>
            <% } else { %>
                <% avisos.forEach(aviso => { %>
                    <div class="aviso-item">
                        <h3><%= aviso.titulo %></h3>
                        <p><%= aviso.conteudo %></p>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>
</body>
</html>
