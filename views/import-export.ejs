<!DOCTYPE html>
<html lang=\"pt-BR\">
<head>
    <meta charset=\"UTF-8\">
    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">
    <title>Importar / Exportar / Anos Letivos - Colégio Estadual Euclides Feliciano Tardin</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background: #f0f4f8; color: #333; -webkit-text-size-adjust: 100%; }
        header { background: #1e3c72; color: white; padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; }
        header h1 { font-size: 18px; }
        header p { font-size: 12px; opacity: 0.9; }
        header a { color: white; text-decoration: none; background: rgba(255,255,255,0.2); padding: 6px 12px; border-radius: 4px; font-size: 13px; font-weight: bold; }
        header a:hover { background: rgba(255,255,255,0.3); }
        .container { max-width: 1000px; margin: 20px auto; padding: 0 10px; }
        
        .card { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.05); margin-bottom: 20px; }
        .card h2 { color: #1e3c72; margin-bottom: 12px; font-size: 16px; border-bottom: 2px solid #eef2f7; padding-bottom: 8px; }
        
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; font-size: 13px; font-weight: bold; color: #1e3c72; margin-bottom: 6px; }
        .form-group select, .form-group input, .form-group textarea { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 6px; font-size: 14px; font-family: inherit; }
        .form-group textarea { height: 140px; font-family: monospace; }
        
        .btn { width: 100%; padding: 12px; background: #1e3c72; color: white; border: none; border-radius: 6px; font-weight: bold; font-size: 14px; cursor: pointer; transition: background 0.3s; text-align: center; }
        .btn:hover { background: #2a5298; }
        .btn-success { background: #28a745; }
        .btn-success:hover { background: #218838; }
        
        .sucesso { background: #d4edda; color: #155724; padding: 12px; border-radius: 6px; margin-bottom: 15px; font-size: 13px; border: 1px solid #c3e6cb; }
        .instrucoes { background: #eef2f7; padding: 12px; border-radius: 6px; font-size: 13px; color: #444; margin-bottom: 15px; line-height: 1.4; }
        .instrucoes b { color: #1e3c72; }

        @media(min-width: 768px) {
            .btn { width: auto; padding: 12px 24px; }
            header h1 { font-size: 20px; }
            .card h2 { font-size: 18px; }
            .card { padding: 25px; }
        }
    </style>
</head>
<body>
    <header>
        <div>
            <h1>Colégio Estadual Euclides F. Tardin</h1>
            <p>Professora Lilian | Gestão de Anos (2026 a 2031)</p>
        </div>
        <a href="/">← Voltar ao Painel</a>
    </header>

    <div class=\"container\">
        <% if (typeof sucesso !== 'undefined' && sucesso) { %>
            <div class=\"sucesso\"><%= sucesso %></div>
        <% } %>

        <!-- Exportar / Promover dados para Anos Futuros (2027 a 2031) -->
        <div class="card">
            <h2>🚀 Promover / Clonar Turma para Anos Futuros (2027 - 2031)</h2>
            <p style="font-size: 13px; color: #555; margin-bottom: 15px;">Selecione a turma atual e para qual ano letivo deseja duplicar os alunos.</p>
            <form action=\"/promover-ano\" method=\"POST\">
                <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin-bottom: 15px;\">
                    <div class=\"form-group\">
                        <label>Ano Origem</label>
                        <select name=\"ano_origem\">
                            <% anos.forEach(a => { %>
                                <option value=\"<%= a %>\"><%= a %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class=\"form-group\">
                        <label>Turma</label>
                        <select name=\"turma_origem\">
                            <% turmas.forEach(t => { %>
                                <option value=\"<%= t %>\"><%= t %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class=\"form-group\">
                        <label>Novo Ano Destino</label>
                        <select name=\"ano_destino\">
                            <% anos.forEach(a => { %>
                                <option value=\"<%= a %>\" <%= a === '2027' ? 'selected' : '' %>><%= a %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <button type=\"submit\" class=\"btn btn-success\">📤 Promover Turma para o Novo Ano</button>
            </form>
        </div>

        <div class=\"card\">
            <h2>📥 Importar Alunos via Diário de Classe</h2>
            <div class=\"instrucoes\">
                <b>Instruções:</b> Cole abaixo os alunos copiados do Word, Excel ou PDF.
            </div>
            <form action=\"/importar-diario\" method=\"POST\">
                <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin-bottom: 15px;\">
                    <div class=\"form-group\">
                        <label>Ano Letivo</label>
                        <select name=\"ano_letivo\">
                            <% anos.forEach(a => { %>
                                <option value=\"<%= a %>\"><%= a %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class=\"form-group\">
                        <label>Turma</label>
                        <select name=\"turma\">
                            <% turmas.forEach(t => { %>
                                <option value=\"<%= t %>\"><%= t %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <div class=\"form-group\">
                    <label>Dados do Aluno (Nome, Matrícula, Telefone)</label>
                    <textarea name=\"dados_brutos\" required placeholder=\"Ex: \n1. Ana Souza - Matr 1001 - Tel 44999998888\n2. Bruno Lima - Matr 1002\"></textarea>
                </div>
                <button type=\"submit\" class=\"btn\">Processar Importação</button>
            </form>
        </div>
    </div>
</body>
</html>
