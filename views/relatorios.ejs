<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Relatórios e Ranking - Colégio Estadual Euclides Feliciano Tardin</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background: #f0f4f8; color: #333; -webkit-text-size-adjust: 100%; }
        header { background: #1e3c72; color: white; padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; }
        header h1 { font-size: 18px; }
        header p { font-size: 12px; opacity: 0.9; }
        header a { color: white; text-decoration: none; background: rgba(255,255,255,0.2); padding: 6px 12px; border-radius: 4px; font-size: 13px; font-weight: bold; }
        header a:hover { background: rgba(255,255,255,0.3); }
        .container { max-width: 1200px; margin: 20px auto; padding: 0 10px; }
        .card { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.05); margin-bottom: 20px; }
        .card h2 { color: #1e3c72; margin-bottom: 15px; font-size: 16px; border-bottom: 2px solid #f0f4f8; padding-bottom: 8px; }
        
        .table-responsive { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid #e1e8ed; border-radius: 6px; }
        table { width: 100%; border-collapse: collapse; min-width: 500px; }
        th, td { padding: 10px; text-align: left; border-bottom: 1px solid #ddd; font-size: 13px; }
        th { background: #1e3c72; color: white; }
        
        .chart-container { position: relative; height: 320px; width: 100%; margin-top: 15px; }
        .filtros { margin-bottom: 15px; display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
        .filtros select, .filtros input { padding: 8px; border-radius: 6px; border: 1px solid #ccc; font-size: 14px; flex: 1; min-width: 160px; }
        
        .btn-print { background: #28a745; color: white; border: none; padding: 10px 16px; font-weight: bold; border-radius: 6px; cursor: pointer; margin-top: 15px; font-size: 13px; width: 100%; text-align: center; display: block; }
        .btn-print:hover { background: #218838; }

        @media(min-width: 768px) {
            .btn-print { width: auto; display: inline-block; }
            header h1 { font-size: 20px; }
            .card h2 { font-size: 18px; }
        }
    </style>
</head>
<body>
    <header>
        <div>
            <h1>Colégio Estadual Euclides F. Tardin</h1>
            <p>Professora Lilian | Relatórios e Desempenho Geral</p>
        </div>
        <a href="/?ano=<%= anoLetivo %>&turma=<%= encodeURIComponent(turmaFiltro) %>">← Voltar ao Painel</a>
    </header>

    <div class="container">
        <!-- Filtro por Ano Letivo e Turma -->
        <div class="card">
            <h2>🔍 Filtrar Relatório e Ranking</h2>
            <form action="/relatorios" method="GET" class="filtros">
                <div style="flex: 1; min-width: 130px;">
                    <label style="display:block; font-size:12px; font-weight:bold; color:#1e3c72; margin-bottom:4px;">Ano Letivo</label>
                    <select name="ano" onchange="this.form.submit()">
                        <% anos.forEach(a => { %>
                            <option value="<%= a %>" <%= a === anoLetivo ? 'selected' : '' %>><%= a %></option>
                        <% }) %>
                    </select>
                </div>
                <div style="flex: 2; min-width: 200px;">
                    <label style="display:block; font-size:12px; font-weight:bold; color:#1e3c72; margin-bottom:4px;">Turma</label>
                    <select name="turma" onchange="this.form.submit()">
                        <% turmas.forEach(t => { %>
                            <option value="<%= t %>" <%= t === turmaFiltro ? 'selected' : '' %>><%= t %></option>
                        <% }) %>
                    </select>
                </div>
            </form>

            <!-- Pódios com 3 Troféus: Turma Selecionada e Geral (todas as turmas) -->
            <% const medalhas = ['🥇 1º Lugar', '🥈 2º Lugar', '🥉 3º Lugar'];
               const coresBg = ['#fff3cd', '#e2e3e5', '#f8d7da'];
               const temTurma = typeof podioTurma !== 'undefined' && podioTurma.length > 0;
               const temGeral = typeof podioGeral !== 'undefined' && podioGeral.length > 0; %>
            <% if (temTurma || temGeral) { %>
                <div style="margin-top: 20px; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 15px;">
                    <% if (temTurma) { %>
                        <div style="background: #eef2f7; padding: 15px; border-radius: 8px; border: 1px solid #d0d7de;">
                            <h3 style="color: #1e3c72; font-size: 15px; margin-bottom: 12px; text-align: center;">🏆 Pódio - Top 3 da Turma (<%= turmaFiltro %>)</h3>
                            <div style="display: grid; gap: 8px;">
                                <% podioTurma.forEach((p, index) => { %>
                                    <div style="background: <%= coresBg[index] || 'white' %>; padding: 8px 10px; border-radius: 6px; border: 1px solid #ccc; display: flex; justify-content: space-between; align-items: center; gap: 10px;">
                                        <div style="min-width: 0;">
                                            <div style="font-size: 12px; font-weight: bold;"><%= medalhas[index] %></div>
                                            <div style="font-size: 13px; font-weight: 600; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= p.nome %></div>
                                        </div>
                                        <div style="font-size: 12px; color: #555; white-space: nowrap;">Média: <b><%= p.media_geral ? p.media_geral.toFixed(1) : '0.0' %></b></div>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>

                    <% if (temGeral) { %>
                        <div style="background: #eef2f7; padding: 15px; border-radius: 8px; border: 1px solid #d0d7de;">
                            <h3 style="color: #1e3c72; font-size: 15px; margin-bottom: 12px; text-align: center;">🏆 Pódio Geral - Top 3 de Todas as Turmas (<%= anoLetivo %>)</h3>
                            <div style="display: grid; gap: 8px;">
                                <% podioGeral.forEach((p, index) => { %>
                                    <div style="background: <%= coresBg[index] || 'white' %>; padding: 8px 10px; border-radius: 6px; border: 1px solid #ccc; display: flex; justify-content: space-between; align-items: center; gap: 10px;">
                                        <div style="min-width: 0;">
                                            <div style="font-size: 12px; font-weight: bold;"><%= medalhas[index] %></div>
                                            <div style="font-size: 13px; font-weight: 600; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= p.nome %></div>
                                            <div style="font-size: 11px; color: #666;">Turma: <%= p.turma %></div>
                                        </div>
                                        <div style="font-size: 12px; color: #555; white-space: nowrap;">Média: <b><%= p.media_geral ? p.media_geral.toFixed(1) : '0.0' %></b></div>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } %>
        </div>

        <!-- Novas Opções de Relatório e Envio -->
        <div class="card" style="border: 2px solid #1e3c72;">
            <h2>📤 Opções de Envio e Exportação de Relatórios</h2>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
                <!-- Por Aluno -->
                <div style="background: #f8f9fa; padding: 15px; border-radius: 8px; border: 1px solid #ddd;">
                    <h3 style="font-size: 14px; color: #1e3c72; margin-bottom: 10px;">👤 Relatório Individual (Aluno)</h3>
                    <div style="margin-bottom: 10px;">
                        <label style="font-size: 11px; font-weight: bold; display: block; margin-bottom: 3px;">Selecione o Aluno:</label>
                        <select id="selectAlunoIndividual" style="width: 100%; padding: 6px; font-size: 12px; border: 1px solid #ccc; border-radius: 4px;">
                            <% 
                            const alunosUnicos = {};
                            (alunosTurmaRows || []).forEach(a => { if (!alunosUnicos[a.aluno_id]) alunosUnicos[a.aluno_id] = a; });
                            Object.values(alunosUnicos).forEach(aluno => { 
                            %>
                                <option value="<%= aluno.aluno_id %>" data-nome="<%= aluno.nome %>" data-tel="<%= aluno.telefone || '' %>"><%= aluno.nome %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div style="display: flex; gap: 5px; flex-wrap: wrap;">
                        <button class="btn" style="background: #25d366; flex: 1; font-size: 11px;" onclick="enviarRelatorioIndividual('whatsapp')">💬 WhatsApp</button>
                        <button class="btn" style="background: #d9534f; flex: 1; font-size: 11px;" onclick="enviarRelatorioIndividual('pdf')">📄 PDF</button>
                        <button class="btn" style="background: #17a2b8; flex: 1; font-size: 11px;" onclick="enviarRelatorioIndividual('excel')">📊 Excel</button>
                    </div>
                </div>

                <!-- Por Turma -->
                <div style="background: #f8f9fa; padding: 15px; border-radius: 8px; border: 1px solid #ddd;">
                    <h3 style="font-size: 14px; color: #1e3c72; margin-bottom: 10px;">👥 Relatório da Turma (<%= turmaFiltro %>)</h3>
                    <p style="font-size: 11px; color: #666; margin-bottom: 12px;">Envia o gráfico de desempenho e ranking da turma selecionada.</p>
                    <div style="display: flex; gap: 5px; flex-wrap: wrap;">
                        <button class="btn" style="background: #25d366; flex: 1; font-size: 11px;" onclick="enviarRelatorioTurma('whatsapp')">💬 WhatsApp</button>
                        <button class="btn" style="background: #d9534f; flex: 1; font-size: 11px;" onclick="enviarRelatorioTurma('pdf')">📄 PDF</button>
                        <button class="btn" style="background: #17a2b8; flex: 1; font-size: 11px;" onclick="enviarRelatorioTurma('excel')">📊 Excel</button>
                    </div>
                </div>

                <!-- Todos os Alunos -->
                <div style="background: #f8f9fa; padding: 15px; border-radius: 8px; border: 1px solid #ddd;">
                    <h3 style="font-size: 14px; color: #1e3c72; margin-bottom: 10px;">🌎 Todos os Alunos (<%= anoLetivo %>)</h3>
                    <p style="font-size: 11px; color: #666; margin-bottom: 12px;">Processa relatórios de todos os alunos do ano letivo.</p>
                    <div style="display: flex; gap: 5px; flex-wrap: wrap;">
                        <button class="btn" style="background: #25d366; flex: 1; font-size: 11px;" onclick="enviarRelatorioTodos('whatsapp')">💬 WhatsApp</button>
                        <button class="btn" style="background: #d9534f; flex: 1; font-size: 11px;" onclick="enviarRelatorioTodos('pdf')">📄 PDF</button>
                        <button class="btn" style="background: #17a2b8; flex: 1; font-size: 11px;" onclick="enviarRelatorioTodos('excel')">📊 Excel</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ranking dos 10 Melhores Alunos de Todas as Turmas -->
        <div class="card">
            <h2>🏆 Top 10 Melhores Alunos (Todas as Turmas - <%= anoLetivo %>)</h2>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Posição</th>
                            <th>Nome do Aluno</th>
                            <th>Turma</th>
                            <th>Média Geral</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (rankingTurma.length === 0) { %>
                            <tr><td colspan="4" style="text-align: center; padding: 20px;">Nenhum aluno encontrado nesta turma para o ano <%= anoLetivo %>.</td></tr>
                        <% } else { %>
                            <% rankingTurma.forEach((r, idx) => { %>
                                <tr>
                                    <td><b>#<%= idx + 1 %></b></td>
                                    <td><%= r.nome %></td>
                                    <td><%= r.turma %></td>
                                    <td><b><%= r.media_geral ? r.media_geral.toFixed(1) : '0.0' %></b></td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Gráfico Geral por Turma -->
        <div class="card">
            <h2>📊 Gráfico de Desempenho Geral da Turma (<%= turmaFiltro %>)</h2>
            <div class="chart-container">
                <canvas id="graficoTurma"></canvas>
            </div>
            <button class="btn-print" onclick="window.print()">🖨️ Imprimir / Exportar Relatório da Turma (PDF)</button>
        </div>
    </div>

    <script>
        const notasTurma = <%- JSON.stringify(notasTurma) %>;
        
        const alunosMap = {};
        notasTurma.forEach(n => {
            if (!alunosMap[n.nome]) alunosMap[n.nome] = [];
            alunosMap[n.nome].push(n.notafinal);
        });

        const nomesAlunos = Object.keys(alunosMap).slice(0, 20);
        const mediasAlunos = nomesAlunos.map(nome => {
            const arr = alunosMap[nome];
            const soma = arr.reduce((a, b) => a + b, 0);
            return (soma / arr.length).toFixed(1);
        });

        const ctx = document.getElementById('graficoTurma').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: nomesAlunos,
                datasets: [{
                    label: `Média Geral por Aluno - Turma ${ <%- JSON.stringify(turmaFiltro) %> }`,
                    data: mediasAlunos,
                    backgroundColor: 'rgba(30, 60, 114, 0.2)',
                    borderColor: '#1e3c72',
                    borderWidth: 2,
                    tension: 0.1,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 10
                    }
                }
            }
        });

        function enviarRelatorioIndividual(tipo) {
            const select = document.getElementById('selectAlunoIndividual');
            const alunoId = select.value;
            const nome = select.options[select.selectedIndex].dataset.nome;
            const tel = select.options[select.selectedIndex].dataset.tel.replace(/\D/g, '');
            
            // Buscar dados da tabela para montar o resumo
            const row = document.querySelector(`input[value="${alunoId}"]`)?.closest('tr');
            const notaFinal = row ? row.querySelector('.lbl-final').textContent : 'N/A';
            const status = row ? row.querySelector('.lbl-status').textContent.trim() : 'N/A';
            const materia = document.querySelector('select[name="materia"]')?.value || 'Matéria';
            const trimestre = document.querySelector('select[name="trimestre"]')?.value || '1';

            if (tipo === 'whatsapp') {
                const msg = encodeURIComponent(`📢 *Comunicado - Colégio Euclides Feliciano Tardin*\n\n*Aluno(a):* ${nome}\n*Matéria:* ${materia} (${trimestre}º Trimestre)\n\n📊 *Desempenho:* Nota ${notaFinal} - *${status}*\n\n*(O relatório completo foi gerado e enviado em arquivo)*`);
                
                if (!tel) {
                    const novoTel = prompt(`Informe o WhatsApp para ${nome}:`, "");
                    if (!novoTel) return;
                    window.open(`https://wa.me/55${novoTel.replace(/\D/g, '')}?text=${msg}`, '_blank');
                } else {
                    window.open(`https://wa.me/55${tel}?text=${msg}`, '_blank');
                }

                // Download automático do arquivo do relatório do aluno em segundo plano
                setTimeout(() => {
                    const link = document.createElement('a');
                    link.href = `/exportar/excel?aluno_id=${alunoId}&ano=<%= anoLetivo %>`;
                    link.style.display = 'none';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                }, 600);
            } else if (tipo === 'pdf') {
                window.open(window.location.origin + `/aluno/${alunoId}`, '_blank');
            } else if (tipo === 'excel') {
                window.location.href = `/exportar/excel?aluno_id=${alunoId}&ano=<%= anoLetivo %>`;
            }
        }

        function enviarRelatorioTurma(tipo) {
            const turma = "<%= turmaFiltro %>";
            
            if (tipo === 'whatsapp') {
                const tel = prompt("Informe o WhatsApp para envio do relatório da turma:", "");
                if (!tel) return;
                
                const msg = encodeURIComponent(`📢 *Comunicado - Colégio Euclides Feliciano Tardin*\n\n*Relatório da Turma:* ${turma} (Ano Letivo <%= anoLetivo %>)\n\n📊 Boletim consolidado da turma.\n\n*(O relatório completo foi gerado e enviado em arquivo)*`);
                window.open(`https://wa.me/55${tel.replace(/\D/g, '')}?text=${msg}`, '_blank');

                // Download automático do arquivo da turma em segundo plano
                setTimeout(() => {
                    const link = document.createElement('a');
                    link.href = `/exportar/excel?turma=${encodeURIComponent(turma)}&ano=<%= anoLetivo %>`;
                    link.style.display = 'none';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                }, 600);
            } else if (tipo === 'pdf') {
                window.print();
            } else if (tipo === 'excel') {
                window.location.href = `/exportar/excel?turma=${encodeURIComponent(turma)}&ano=<%= anoLetivo %>`;
            }
        }

        function enviarRelatorioTodos(tipo) {
            if (tipo === 'whatsapp') {
                const tel = prompt("Informe o WhatsApp para envio do relatório geral:", "");
                if (!tel) return;
                
                const msg = encodeURIComponent(`📢 *Comunicado - Colégio Euclides Feliciano Tardin*\n\n*Relatório Geral* (Ano Letivo <%= anoLetivo %>)\n\n📊 Relatório geral consolidado.\n\n*(O relatório completo foi gerado e enviado em arquivo)*`);
                window.open(`https://wa.me/55${tel.replace(/\D/g, '')}?text=${msg}`, '_blank');

                // Download automático do arquivo geral em segundo plano
                setTimeout(() => {
                    const link = document.createElement('a');
                    link.href = `/exportar/excel?ano=<%= anoLetivo %>`;
                    link.style.display = 'none';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                }, 600);
            } else if (tipo === 'pdf') {
                window.print();
            } else if (tipo === 'excel') {
                window.location.href = `/exportar/excel?ano=<%= anoLetivo %>`;
            }
        }
    </script>
</body>
</html>
